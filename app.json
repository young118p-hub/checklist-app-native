{
  "expo": {
    "name": "아맞다이거! - 체크리스트",
    "slug": "checklist-app-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "description": "한국 상황에 특화된 체크리스트 앱. 출장, 여행, 캠핑, 차박 등 다양한 상황별 템플릿으로 깜빡할 뻔한 것들을 완벽하게 준비하세요!",
    "platforms": [
      "android"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#DC2626"
      },
      "package": "com.checklist.amajdaigeo",
      "versionCode": 27,
      "permissions": [
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "./plugins/withPageAlignment",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#DC2626"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.otf",
            "./assets/fonts/Pretendard-Medium.otf",
            "./assets/fonts/Pretendard-SemiBold.otf",
            "./assets/fonts/Pretendard-Bold.otf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F2553D"
        }
      ]
    ],
    "scheme": "amajdaigeo",
    "extra": {
      "eas": {
        "projectId": "05c002d8-8023-45d0-8569-a3c18e207ec4"
      }
    },
    "owner": "edenqw1",
    "runtimeVersion": "1.0.0"
  }
}
